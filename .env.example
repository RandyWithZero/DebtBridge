PORT=3000
CLIENT_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002
CLIENT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# API-only backend CORS allowlist for the two independent frontend apps.
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# Optional comma-separated extra origins, for previews or deployed frontend URLs.
CORS_ORIGINS=

# Local PostgreSQL used by docker-compose and CI migration checks.
POSTGRES_DB=debtbridge
POSTGRES_USER=debtbridge
POSTGRES_PASSWORD=debtbridge_dev_password
DATABASE_URL=postgres://debtbridge:debtbridge_dev_password@localhost:5432/debtbridge
