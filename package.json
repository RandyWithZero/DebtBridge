{
  "name": "debtbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node apps/api/src/server.js",
    "start:api": "node apps/api/src/server.js",
    "test": "node --test",
    "db:generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://debtbridge:debtbridge@localhost:5432/debtbridge?schema=public}\" prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://debtbridge:debtbridge@localhost:5432/debtbridge?schema=public}\" prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "prisma": "^7.6.0"
  },
  "engines": {
    "node": ">=24"
  }
}
